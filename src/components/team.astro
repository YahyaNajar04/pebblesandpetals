---
import team from "../data/team.json";
const chair = team.find((m) => m.featured);
const others = team.filter((m) => !m.featured);
const rings = ["bg-sunny", "bg-sky", "bg-coral", "bg-grass"];
---
<section class="mx-auto max-w-7xl px-4 py-20">
  {chair && (
    <div class="mb-16">
      <h2 class="text-center font-display text-4xl font-bold text-coral md:text-5xl">Our Chairperson</h2>
      <div class="mt-8 grid items-center gap-8 rounded-2xl border-3 border-ink bg-white p-8 shadow-[6px_6px_0_var(--color-sunny)] md:grid-cols-[auto_1fr]">
        <div class="text-center">
          {chair.photo
            ? <img src={`/team/${chair.photo}`} alt={chair.name} class="mx-auto h-48 w-48 rounded-full border-3 border-ink object-cover" />
            : <div class="mx-auto flex h-48 w-48 items-center justify-center rounded-full border-3 border-dashed border-sky bg-sunny/20 text-5xl">👩‍🏫</div>}
          <h3 class="mt-4 font-display text-2xl">{chair.name}</h3>
          <p class="font-display text-coral">{chair.role}</p>
        </div>
        <div>
          {chair.bio.split("\n\n").map((p) => <p class="mt-4 leading-relaxed first:mt-0">{p}</p>)}
        </div>
      </div>
    </div>
  )}

  <h2 class="text-center font-display text-4xl font-bold text-coral md:text-5xl">Meet Our Team</h2>
  <p class="mt-2 text-center">Tap a card to read more about them.</p>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
    {others.map((m, i) => (
      <div
        data-bio={m.bio}
        data-name={m.name}
        data-role={m.role}
        data-photo={m.photo}
        class={`rounded-2xl border-3 border-ink bg-white p-6 text-center transition ${m.bio ? "cursor-pointer hover:-translate-y-1" : ""}`}
        style={`box-shadow: 5px 5px 0 var(--color-${["sunny","sky","coral","grass"][i % 4]})`}
      >
        {m.photo
          ? <img src={`/team/${m.photo}`} alt={m.name} class="mx-auto h-24 w-24 rounded-full border-3 border-ink object-cover" />
          : <div class={`mx-auto flex h-24 w-24 items-center justify-center rounded-full border-3 border-ink text-4xl ${rings[i % 4]}/30`}>👩‍🏫</div>}
        <h3 class="mt-3 font-display text-lg">{m.name || "Joining soon"}</h3>
        <p class="font-display text-sm text-sky">{m.role}</p>
        {m.bio && <p class="mt-2 text-xs text-coral">Read more →</p>}
      </div>
    ))}
  </div>
</section>

<!-- Bio modal -->
<div id="bio-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/70 p-4">
  <div class="relative max-h-[85vh] w-full max-w-4xl overflow-y-auto rounded-2xl border-3 border-ink bg-white p-8">
    <button id="bio-close" aria-label="Close" class="absolute right-4 top-3 text-3xl text-ink/60 hover:text-coral">✕</button>

    <div class="grid gap-8 md:grid-cols-[auto_1fr] md:items-center">
      <!-- Left: photo + name + role -->
      <div class="text-center md:w-52">
        <div id="bio-photo"></div>
        <h3 id="bio-name" class="mt-4 font-display text-xl text-coral"></h3>
        <p id="bio-role" class="font-display text-sm text-sky"></p>
      </div>
      <!-- Right: bio -->
      <div id="bio-text" class="min-w-0"></div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("bio-modal");
  const nameEl = document.getElementById("bio-name");
  const roleEl = document.getElementById("bio-role");
  const textEl = document.getElementById("bio-text");
  const photoEl = document.getElementById("bio-photo");

  if (modal && nameEl && roleEl && textEl && photoEl) {
    const close = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
    };

    document.addEventListener("click", (e) => {
      const card = (e.target as HTMLElement).closest("[data-bio]");
      if (card) {
        const bio = card.getAttribute("data-bio") || "";
        if (!bio) return;

        nameEl.textContent = card.getAttribute("data-name") || "";
        roleEl.textContent = card.getAttribute("data-role") || "";

        // photo (or emoji fallback)
        const photo = card.getAttribute("data-photo");
        photoEl.innerHTML = photo
          ? `<img src="/team/${photo}" alt="" class="mx-auto h-40 w-40 rounded-full border-3 border-ink object-cover" />`
          : `<div class="mx-auto flex h-40 w-40 items-center justify-center rounded-full border-3 border-ink bg-sunny/30 text-5xl">👩‍🏫</div>`;

        // bio paragraphs
        textEl.innerHTML = "";
        bio.split("\n\n").forEach((para) => {
          const p = document.createElement("p");
          p.className = "mt-3 text-sm leading-relaxed first:mt-0";
          p.textContent = para;
          textEl.appendChild(p);
        });

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
        return;
      }
      if (e.target === modal || (e.target as HTMLElement).id === "bio-close") close();
    });

    document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
  }
</script>