---
import { WHATSAPP, INSTAGRAM } from "../lib/site";
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/programs", label: "Programs" },
  { href: "/resources", label: "Resources" },
  { href: "/fees", label: "Fees" },
  { href: "/faq", label: "FAQ" },
  { href: "/contact", label: "Contact Us" },
];
const norm = (p: string) => (p !== "/" ? p.replace(/\/$/, "") : "/");
const current = norm(Astro.url.pathname);
---

<header class="sticky top-0 z-50 border-b-4 border-sunny bg-white">
  <div class="mx-auto flex items-center justify-between px-4 py-3">
    <a href="/" class="flex shrink-0 items-center gap-2">
      <img src="/icon.jpeg" alt="Pebbles & Petals Logo" class="h-16 w-16" />
      <div class="flex flex-col leading-tight whitespace-nowrap">
        <span class="font-display text-2xl text-coral">Pebbles and Petals</span>
        <span class="font-display text-xl text-sky">Pre-School</span>
      </div>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden gap-5 font-display text-lg lg:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class={norm(l.href) === current ? "text-coral" : "hover:text-sky"}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop contact buttons -->
<div class="hidden shrink-0 items-center gap-3 lg:flex">
  <a href={INSTAGRAM} target="_blank" rel="noopener" aria-label="Follow us on Instagram"
    class="flex h-11 w-11 items-center justify-center rounded-2xl border-3 border-ink bg-gradient-to-tr from-[#F58529] via-[#DD2A7B] to-[#8134AF] shadow-[3px_3px_0_var(--color-ink)] transition hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0_var(--color-ink)]">
    <svg viewBox="0 0 24 24" class="h-6 w-6 fill-white" aria-hidden="true">
      <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.06 1.17-.26 1.8-.42 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.07.36-2.24.41-1.27.06-1.65.07-4.86.07s-3.59-.01-4.86-.07c-1.17-.06-1.82-.26-2.24-.42-.57-.22-.96-.48-1.38-.9-.42-.42-.69-.82-.9-1.38-.16-.42-.36-1.06-.42-2.23C2.11 15.58 2.1 15.2 2.1 12s.01-3.59.06-4.86c.06-1.17.26-1.81.42-2.23.21-.57.48-.96.9-1.38.42-.42.81-.69 1.38-.9.42-.17 1.05-.36 2.22-.42C8.35 2.17 8.73 2.16 12 2.16zM12 0C8.74 0 8.33.02 7.05.07 5.78.13 4.91.33 4.14.63c-.79.31-1.46.72-2.13 1.38C1.35 2.68.94 3.35.63 4.14.33 4.91.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.02 3.67.07 4.95c.06 1.28.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13.67.67 1.34 1.08 2.13 1.38.77.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.02 4.95-.07c1.28-.06 2.15-.26 2.91-.56.79-.31 1.46-.72 2.13-1.38.67-.67 1.08-1.34 1.38-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.02-3.67-.07-4.95c-.06-1.28-.26-2.15-.56-2.91-.31-.79-.72-1.46-1.38-2.13C21.32 1.35 20.65.94 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0z"/>
      <path d="M12 5.84a6.16 6.16 0 100 12.32 6.16 6.16 0 000-12.32zM12 16a4 4 0 110-8 4 4 0 010 8z"/>
      <circle cx="18.41" cy="5.59" r="1.44"/>
    </svg>
  </a>

  <a href={WHATSAPP} class="rounded-2xl border-3 border-ink bg-grass px-5 py-2 font-display text-white shadow-[3px_3px_0_var(--color-ink)]">
    Whatsapp
  </a>
</div>

    <!-- Hamburger (mobile + tablet) -->
    <button id="menu-btn" aria-label="Open menu" class="text-3xl lg:hidden"
      >☰</button
    >
  </div>

  <!-- Mobile menu panel -->
  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t-3 border-sunny bg-white px-4 py-4 font-display text-lg lg:hidden"
  >
    {
      links.map((l) => (
        <a
          href={l.href}
          class={norm(l.href) === current ? "text-coral" : "hover:text-sky"}
        >
          {l.label}
        </a>
      ))
    }
  </nav>
</header>


<div class="fixed bottom-5 right-5 z-50 flex flex-col gap-3 lg:hidden">
  <a href={INSTAGRAM} target="_blank" rel="noopener" aria-label="Follow us on Instagram"
    class="flex h-14 w-14 items-center justify-center rounded-full border-3 border-ink bg-gradient-to-tr from-[#F58529] via-[#DD2A7B] to-[#8134AF] shadow-[3px_3px_0_var(--color-ink)] transition active:translate-x-[2px] active:translate-y-[2px] active:shadow-[1px_1px_0_var(--color-ink)]">
    <svg viewBox="0 0 24 24" class="h-7 w-7 fill-white" aria-hidden="true">
      <!-- same three paths as above -->
    </svg>
  </a>

  <!-- your existing WhatsApp floating <a>, minus its own `fixed bottom-5 right-5 z-50` and `lg:hidden` classes -->
</div>

<!-- Floating WhatsApp button (mobile + tablet) -->
<a
  href={WHATSAPP}
  aria-label="Chat with us on WhatsApp"
  class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full border-3 border-ink bg-[#25D366] shadow-[3px_3px_0_var(--color-ink)] transition active:translate-x-[2px] active:translate-y-[2px] active:shadow-[1px_1px_0_var(--color-ink)] lg:hidden"
>
  <svg viewBox="0 0 24 24" class="h-8 w-8 fill-white" aria-hidden="true">
    <path
      d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m0 1.67c2.2 0 4.26.86 5.82 2.42a8.21 8.21 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23-1.48 0-2.93-.39-4.19-1.15l-.3-.17-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24M8.53 7.33c-.16 0-.43.06-.66.31-.22.25-.87.86-.87 2.07 0 1.22.89 2.39 1 2.56.14.17 1.76 2.67 4.25 3.73.59.27 1.05.42 1.41.53.59.19 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.16-.48-.27-.25-.14-1.47-.74-1.69-.82-.23-.08-.37-.12-.56.12-.16.25-.64.81-.78.97-.15.17-.29.19-.53.07-.26-.13-1.06-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.12-.24-.01-.39.11-.5.11-.11.27-.29.37-.44.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.11-.56-1.35-.77-1.84-.2-.48-.4-.42-.56-.43-.14 0-.3-.01-.47-.01z"
    ></path>
  </svg>
</a>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const open = menu.classList.toggle("flex");
      menu.classList.toggle("hidden");
      btn.textContent = open ? "✕" : "☰";
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    });
  }
</script>
