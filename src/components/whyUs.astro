---
import Card from "./card.astro";

const items = [
  { emoji: "🛡️", title: "Safety First", color: "text-coral", shadow: "var(--color-sunny)", text: "CCTV in every classroom, secure ID-checked entry, plus an on-call child psychologist." },
  { emoji: "📚", title: "UK-Based Curriculum", color: "text-sky", shadow: "var(--color-sky)", text: "Play-based learning packed with curiosity and confidence." },
  { emoji: "🏊", title: "Epic Facilities", color: "text-grass", shadow: "var(--color-coral)", text: "Swimming pool, go-karting track, sand & clay pits, sensory play zone." },
  { emoji: "📱", title: "Parent Portal", color: "text-coral", shadow: "var(--color-grass)", text: "Live updates, attendance, photos & progress — right on your phone." },
  { emoji: "🧩", title: "Montessori Tools", color: "text-sky", shadow: "var(--color-sunny)", text: "Hands-on materials that build little motor skills & big ideas." },
  { emoji: "🍎", title: "Yummy, Healthy Meals", color: "text-grass", shadow: "var(--color-grass)", text: "Nutritious, child-friendly menus made fresh daily." },
];
---
<section class="py-20 overflow-hidden">
  <h2 class="text-center font-display text-4xl font-bold text-coral md:text-5xl">
    Why Kids Love It Here!
  </h2>

  <div
    id="why-scroller"
    class="why-scroller mt-10 flex cursor-grab gap-6 overflow-x-auto px-4 pb-4 [mask-image:linear-gradient(to_right,transparent,black_5%,black_95%,transparent)]"
  >
    {[...items, ...items].map((item) => (
      <Card shadow={item.shadow} class="w-64 shrink-0 select-none">
        <div class="text-4xl">{item.emoji}</div>
        <h3 class={`mt-3 font-display text-xl ${item.color}`}>{item.title}</h3>
        <p class="mt-2 text-sm">{item.text}</p>
      </Card>
    ))}
  </div>
</section>

<style>
  .why-scroller {
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-x: contain;      /* stop swipe triggering back-navigation */
    -webkit-overflow-scrolling: touch;   /* smooth iOS momentum */
  }
  .why-scroller::-webkit-scrollbar { display: none; }
</style>

<script>
  const el = document.getElementById("why-scroller");
  if (el) {
    let paused = false;
    let idleTimer: number | undefined;
    let pos = 0;                 // our own float position
    const speed = 0.5;           // px per frame
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const scheduleResume = () => {
      clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => {
        pos = el.scrollLeft;     // sync to wherever the user left it
        paused = false;
      }, 1200);
    };

    // auto-scroll loop
    const tick = () => {
      if (!paused && !reduce) {
        pos += speed;
        const half = el.scrollWidth / 2;
        if (pos >= half) pos -= half;   // seamless loop
        el.scrollLeft = pos;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    // pause on wheel / touch, resume once scrolling settles
    el.addEventListener("wheel", () => { paused = true; scheduleResume(); }, { passive: true });
    el.addEventListener("touchstart", () => { paused = true; clearTimeout(idleTimer); }, { passive: true });
    el.addEventListener("touchend", scheduleResume, { passive: true });

    // click-and-drag — MOUSE ONLY (touch uses native scrolling)
    let isDown = false, startX = 0, startScroll = 0;
    el.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") return;
      isDown = true; paused = true;
      startX = e.pageX; startScroll = el.scrollLeft;
      el.style.cursor = "grabbing";
      el.setPointerCapture(e.pointerId);
    });
    el.addEventListener("pointermove", (e) => {
      if (isDown && e.pointerType === "mouse") el.scrollLeft = startScroll - (e.pageX - startX);
    });
    const endDrag = (e: PointerEvent) => {
      if (e.pointerType !== "mouse") return;
      isDown = false; el.style.cursor = "grab"; scheduleResume();
    };
    el.addEventListener("pointerup", endDrag);
    el.addEventListener("pointercancel", endDrag);
  }
</script>